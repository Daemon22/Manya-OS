# ==============================================================================
# Supabase Configuration for @manya-os/supabase
# ==============================================================================
# This file provides environment-based configuration for both local development
# and production deployments. Copy this file to .env and fill in the appropriate
# values for your environment.
#
# IMPORTANT SECURITY NOTES:
# - Never commit .env files to version control
# - Service-role keys and database URLs are SERVER-SIDE ONLY
# - Never expose these credentials to browser/client-side code
# ==============================================================================

# -----------------------------------------------------------------------------
# REQUIRED CONFIGURATION (all environments)
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xyz.supabase.co)
# For local development using the embedded Postgres script, this will be set
# automatically by scripts/setup-local-supabase.js
SUPABASE_URL=

# Service-role key — SERVER-SIDE ONLY. Never expose to clients.
# Found in: Supabase Dashboard > Settings > API > service_role key
# For local development, this will be generated automatically by the setup script
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# DATABASE CONNECTION FOR MIGRATIONS (recommended for fresh databases)
# -----------------------------------------------------------------------------

# Direct PostgreSQL URL for fresh-database migrations. SERVER-SIDE ONLY.
# This enables the trusted migration executor for bootstrapping fresh databases
# before the Supabase RPC helpers exist.
#
# LOCAL DEVELOPMENT:
# Use your local PostgreSQL connection string. For the embedded Postgres setup:
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:15432/manya_test
#
# PRODUCTION:
# Use your cloud provider's private/direct PostgreSQL URL (not the public URL).
# Supabase: Get from Dashboard > Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
#
# If not provided, migrations will fall back to Supabase RPC (requires existing DB)
SUPABASE_DB_URL=
# Alternative: DATABASE_URL (also read if SUPABASE_DB_URL is not set)
# DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Anonymous key — safe for client-side use. Optional.
# Found in: Supabase Dashboard > Settings > API > anon public key
SUPABASE_ANON_KEY=

# Automatically run pending migrations on first connection. Default: false.
# Set to 'true' for automated migration on application startup
SUPABASE_MIGRATE_ON_START=false

# Path to migration SQL files. Default: ./migrations
# Only needed if using a custom migration directory
# SUPABASE_MIGRATION_DIR=./migrations

# Query timeout in milliseconds. Default: 30000
# SUPABASE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# TESTING CONFIGURATION
# -----------------------------------------------------------------------------

# Set to 'true' to run integration tests against a real Supabase instance
# For local development, use scripts/setup-local-supabase.js to set this up
SUPABASE_INTEGRATION_TEST=false
