# Supabase Configuration for @manya-os/supabase
# Required for integration tests and production use.

# Your Supabase project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL=

# Service-role key — SERVER-SIDE ONLY. Never expose to clients.
# Found in: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous key — safe for client-side use. Optional.
# Found in: Supabase Dashboard > Settings > API > anon public key
SUPABASE_ANON_KEY=

# Automatically run pending migrations on first connection. Default: false.
SUPABASE_MIGRATE_ON_START=false

# Path to migration SQL files. Default: ./migrations
# SUPABASE_MIGRATION_DIR=./migrations

# Query timeout in milliseconds. Default: 30000
# SUPABASE_TIMEOUT_MS=30000

# Set to 'true' to run integration tests against a real Supabase instance
SUPABASE_INTEGRATION_TEST=false
